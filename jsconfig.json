{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./resources/js/*"]
    },
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "preserve",
    "strict": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["resources/js/**/*"],
  "exclude": ["node_modules", "dist"]
}